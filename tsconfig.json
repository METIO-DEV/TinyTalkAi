{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2020",
        "ignoreDeprecations": "6.0",
        "baseUrl": "./",
        "paths": {
            "@/*": ["resources/js/*"]
        },
        "strict": false,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["resources/js/**/*"]
}
